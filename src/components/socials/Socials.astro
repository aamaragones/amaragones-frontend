---
import SocialCard from "./SocialCard.astro";
import SvgIcon from "./SvgIcon.astro";
import socialsData from "../../data/socials.json";

interface Social {
    platform: string;
    handle: string;
    url: string;
    svgPath: string;
}

const socials: Social[] = socialsData;
---

<section class="socials-container">
    {
        socials.map((social) => (
            <SocialCard
                platform={social.platform}
                handle={social.handle}
                url={social.url}
                svgPath={social.svgPath}
            />
        ))
    }
</section>

<style>
    .socials-container {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
    }

    @media (max-width: 768px) {
        .socials-container {
            gap: 2.4rem;
            max-width: 100%;
        }
    }
</style>
