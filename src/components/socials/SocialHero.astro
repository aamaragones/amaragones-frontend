---
interface Props {
    title: string;
    overtitle?: string;
    description?: string;
}

const { title, overtitle, description } = Astro.props;
---

<section class="hero socials-hero" role="region" aria-label={title}>
    {overtitle && <div class="overtitle font-ui">{overtitle}</div>}
    <h1 class="font-titulo">{title}</h1>
    {
        description && (
            <p style="font-weight: 800; color: rgb(255, 249, 198);">
                {description}
            </p>
        )
    }
</section>

<style>
    .hero.socials-hero {
        text-align: center;
        padding: 8rem 2rem;
        border-bottom: 1px solid rgba(138, 106, 61, 0.2);
    }

    .hero.socials-hero h1 {
        font-size: 3.5rem;
        margin-bottom: 1.5rem;
        letter-spacing: 0.05em;
        color: var(--hero-titulo);
    }

    .hero.socials-hero .overtitle {
        color: var(--acento-oro);
        font-weight: 600;
        font-family: "Montserrat", sans-serif;
        font-size: 0.9rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .hero .overtitle {
        color: var(--acento-oro);
        font-weight: 600;
        font-family: "Montserrat", sans-serif;
        font-size: 0.9rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    @media (max-width: 768px) {
        .hero.socials-hero {
            padding: 4rem 1rem;
        }
        .hero.socials-hero h1 {
            font-size: 2.5rem;
        }
    }
</style>
