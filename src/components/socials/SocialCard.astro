---
import ShieldIcon from "./ShieldIcon.astro";

interface Props {
    platform: string; // Ej: "TikTok"
    handle: string; // Ej: "@autor_fantasia"
    url: string; // Ej: "https://tiktok.com/..."
    svgPath: string; // SVG path para el icono
}

const { platform, handle, url, svgPath } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="social-box">
    <div class="shield-wrapper">
        <ShieldIcon svgPath={svgPath} altText={`Icono de ${platform}`} />
    </div>

    <div class="box-content">
        <span class="platform-title">{platform}</span>
        <span class="platform-handle">{handle}</span>
    </div>
</a>

<style>
    /* Variables basadas exactamente en tu paleta de colores */
    :root {
        --color-bg-tinta: #0b0f14;
        --color-bg-noche: #0f1424;
        --color-ambar-hechizo: #e3a857;
        --color-pergamino: #e8e1d1;
        --color-gris-ceniza: #b7b2a6;
    }

    .social-box {
        position: relative;
        display: flex;
        align-items: center;

        background: linear-gradient(135deg, transparent, var(--color-bg-noche));
        border: 1px solid var(--acento-oro-viejo);
        border-left: 0;

        padding: 18px 24px 18px 80px;
        margin-left: 32px;

        text-decoration: none;
        border-radius: 0px;
        transition:
            transform 0.3s cubic-bezier(0.25, 1, 0.5, 1),
            border-color 0.3s ease,
            box-shadow 0.3s ease;
    }

    .shield-wrapper {
        position: absolute;
        left: -32px;
        top: 50%;
        transform: translateY(-50%);
        transition: transform 0.3s ease;
    }

    .social-box:hover {
        border-color: var(--color-ambar-hechizo);
        transform: translateX(6px);
    }

    .social-box:hover .shield-wrapper {
        transform: translateY(-50%) scale(1.08);
    }

    html.light-mode .social-box {
        background: none;
    }

    .box-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .platform-title {
        font-family: "Trajan Pro", serif;
        color: var(--color-pergamino);
        font-size: 1.15rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    html.light-mode .platform-title {
        color: var(--acento-oro);
    }

    .platform-handle {
        font-family: "Montserrat", sans-serif;
        color: var(--color-gris-ceniza);
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
</style>
