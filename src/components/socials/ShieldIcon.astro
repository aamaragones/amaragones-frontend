---
interface Props {
    svgPath?: string; // SVG path para iconos inline
    iconSrc?: string; // Ruta al SVG o PNG del icono de la red social (Tiktok, X, etc.)
    altText: string;
}

const { svgPath, iconSrc, altText } = Astro.props;
import socialShield from "../../assets/socials/social_shield.png";
---

<div class="shield-container">
    <img src={socialShield.src} alt="" class="shield-bg" aria-hidden="true" />

    {
        svgPath ? (
            <svg viewBox="0 0 16 16" class="social-icon" aria-label={altText}>
                <path d={svgPath} />
            </svg>
        ) : (
            <img src={iconSrc} alt={altText} class="social-icon" />
        )
    }
</div>

<style>
    .shield-container {
        position: relative;
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .shield-bg {
        position: absolute;
        top: -26px;
        left: -27px;
        width: 116px;
        height: 116px;
        object-fit: cover;
        pointer-events: none;
        overflow: visible;
    }

    .social-icon {
        position: relative;
        z-index: 2;
        width: 55%;
        height: 55%;
        object-fit: contain;
        filter: sepia(0.3) contrast(1.1);
        fill: var(--acento-oro);
    }

    @media (max-width: 768px) {
        .shield-bg {
            left: -13px;
        }
        .social-icon {
            left: 13px;
        }
    }
</style>
