---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="store">
  <div class="container">
    <div class="store-header font-titulo">{title}</div>
    <div class="cards-container">
      <slot />
    </div>
  </div>
</section>

<style>
  .store {
    padding: 2rem 10% 5rem;
    text-align: center;
  }

  .store-header {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    color: var(--acento-oro);
    margin-bottom: 4rem;
    font-size: 2.5rem;
  }

  .store-header::before,
  .store-header::after {
    content: "";
    height: 1px;
    width: 80px;
    background-color: var(--acento-bronce);
  }

  .cards-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .container {
    max-width: var(--content-max-width);
    width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (max-width: 768px) {
    .store {
      padding: 2rem 1rem 4rem;
    }

    .store-header {
      font-size: 1.75rem;
      margin-bottom: 2rem;
    }

    .store-header::before,
    .store-header::after {
      width: 40px;
    }

    .cards-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
