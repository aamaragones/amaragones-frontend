---
interface Props {
    title: string;
    subtitle?: string;
    backgroundGradient?: string;
}

const {
    title,
    subtitle,
    backgroundGradient = "linear-gradient(135deg, rgba(44, 90, 122, 0.8) 0%, rgba(45, 90, 61, 0.8) 100%)",
} = Astro.props;
---

<div
    class="card"
    style={`background: ${backgroundGradient}, radial-gradient(circle at center, rgba(198, 161, 91, 0.1) 0%, rgba(15, 26, 36, 1) 100%);`}
>
    <h3 class="font-titulo">{title}</h3>
    {subtitle && <div class="card-subtitle font-ui">{subtitle}</div>}
</div>

<style>
    .card {
        background-size: cover;
        background-position: center;
        overflow: hidden;
    }

    .card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(
            circle at center,
            rgba(198, 161, 91, 0.1) 0%,
            rgba(15, 26, 36, 0.9) 100%
        );
        pointer-events: none;
    }

    .card > :global(*) {
        position: relative;
        z-index: 1;
    }

    .card h3 {
        font-size: 1.5rem;
        color: var(--texto-claro);
        margin-bottom: 2rem;
        line-height: 1.3;
    }

    .card-subtitle {
        color: var(--acento-bronce);
        margin-top: auto;
    }
</style>
