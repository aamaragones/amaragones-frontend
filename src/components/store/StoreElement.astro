---
interface Props {
    title: string;
    subtitle?: string;
    backgroundGradient?: string;
    image?: string;
    textColor?: string;
}

const {
    title,
    subtitle,
    backgroundGradient = "linear-gradient(135deg, rgba(44, 90, 122, 0.8) 0%, rgba(45, 90, 61, 0.8) 100%)",
    image,
    textColor = "#E8E1D1",
} = Astro.props;

const backgroundStyle = image
    ? `background: ${backgroundGradient}, url(${image}) center/cover;`
    : `background: ${backgroundGradient}, radial-gradient(circle at center, rgba(198, 161, 91, 0.1) 0%, rgba(15, 26, 36, 1) 100%);`;
---

<div class="card store-element-card" style={`--card-text-color: ${textColor};`}>
    <div class="card-bg" style={backgroundStyle}></div>
    <h3 class="font-titulo">{title}</h3>
</div>

<style>
    .store-element-card {
        padding: 0;
        height: 390px;
        width: 312px;
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
    }

    .card {
        overflow: hidden;
    }

    .card-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        z-index: 0;
    }

    .card::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 1px solid rgba(138, 106, 61, 1);
        pointer-events: none;
        z-index: 2;
    }

    .card > :global(*:not(.card-bg)) {
        position: relative;
        z-index: 1;
    }

    .card h3 {
        font-size: 1rem;
        color: var(--card-text-color);
        line-height: 1.3;
        margin: 0 0 0.8rem 0;
        padding: 0 1rem;
    }

    .card-subtitle {
        color: var(--card-text-color);
        margin-top: auto;
    }
</style>
