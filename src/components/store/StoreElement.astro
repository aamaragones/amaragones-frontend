---
interface Props {
    title: string;
    subtitle?: string;
    backgroundGradient?: string;
    image?: string;
    textColor?: string;
}

const {
    title,
    subtitle,
    backgroundGradient = "linear-gradient(135deg, rgba(44, 90, 122, 0.8) 0%, rgba(45, 90, 61, 0.8) 100%)",
    image,
    textColor = "#E8E1D1",
} = Astro.props;

const backgroundStyle = image
    ? `background: ${backgroundGradient}, url(${image}) center/cover;`
    : `background: ${backgroundGradient}, radial-gradient(circle at center, rgba(198, 161, 91, 0.1) 0%, rgba(15, 26, 36, 1) 100%);`;
---

<div
    class="card store-element-card"
    style={`${backgroundStyle} --card-text-color: ${textColor}; border: none;`}
>
    <h3 class="font-titulo">{title}</h3>
</div>

<style>
    .store-element-card {
        padding-top: 4rem;
        padding-bottom: 0;
        padding-left: 0rem;
        padding-right: 0rem;
        height: 390px;
        width: 312px;
        display: flex;
        justify-content: flex-end;
    }

    .card {
        background-size: cover;
        background-position: center;
        overflow: hidden;
    }

    .card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
    }

    .card > :global(*) {
        position: relative;
        z-index: 1;
    }

    .card h3 {
        font-size: 1rem;
        color: var(--card-text-color);
        line-height: 1.3;
        margin-bottom: 0.8rem;
    }

    .card-subtitle {
        color: var(--card-text-color);
        margin-top: auto;
    }
</style>
