---
interface Props {
    title: string;
    ariaLabel?: string;
    noStack?: boolean;
}

const { title, ariaLabel, noStack = false } = Astro.props;
---

<section class="works" role="region">
    <div class="container">
        <div class="works-header font-titulo">{title}</div>
        <div
            class={`cards-container${noStack ? " no-stack" : ""}`}
            role="region"
            aria-label={ariaLabel ?? title}
        >
            <slot />
        </div>
    </div>
</section>

<style>
    .works {
        padding: 2rem 10% 5rem;
        text-align: center;
    }

    .works-header {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        font-size: 2.5rem;
        color: var(--acento-oro);
        margin-bottom: 4rem;
    }

    .works-header::before,
    .works-header::after {
        content: "";
        height: 1px;
        width: 80px;
        background-color: var(--acento-bronce);
    }

    .container {
        max-width: var(--content-max-width);
        width: 100%;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    @media (max-width: 768px) {
        .works {
            padding: 2rem 1rem 4rem;
        }

        .works-header::before,
        .works-header::after {
            width: 40px;
        }
    }
</style>
