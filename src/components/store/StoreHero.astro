---
interface Props {
    title: string;
    overtitle?: string;
    description?: string;
}

const { title, overtitle = "Próximamente", description } = Astro.props;
---

<section
    class="hero"
    role="region"
    aria-label={title}
    style="background: radial-gradient(circle at center, rgba(44, 90, 122, 0.1) 0%, rgba(15, 26, 36, 1) 90%), url('/src/assets/hero/store_hero.png') top/cover;"
>
    {overtitle && <div class="overtitle font-ui">{overtitle}</div>}
    <h1 class="font-titulo">{title}</h1>
    {
        description && (
            <p style="font-weight: 800; color: rgb(255, 249, 198);">
                {description}
            </p>
        )
    }
</section>

<style>
    .hero {
        text-align: center;
        padding: 6rem 2rem;
    }

    .hero .overtitle {
        color: var(--acento-oro);
        font-weight: 600;
        font-family: "Montserrat", sans-serif;
        font-size: 0.9rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    @media (max-width: 768px) {
        .hero {
            padding: 4rem 1rem;
        }
    }
</style>
