---
import worksStack from "../../scripts/works-stack.js?url";
---

<section
    class="works works-no-carousel"
    role="region"
    aria-label="Obras destacadas"
>
    <div class="container">
        <div class="works-header font-titulo">Saga Similis</div>
        <div class="cards-container">
            <div class="card pluma-y-espada">
                <h3 class="font-titulo">Similis<br />Pluma y Espada</h3>
                <div class="card-subtitle font-ui">Saga Similis<br />I</div>
            </div>

            <div class="card">
                <h3 class="font-titulo">Similis<br />Reino de Alas</h3>
                <div class="card-subtitle font-ui">Saga Similis<br />II</div>
            </div>

            <div class="card">
                <h3 class="font-titulo">Similis<br />La Era Oscura</h3>
                <div class="card-subtitle font-ui">Saga Similis<br />III</div>
            </div>

            <div class="card">
                <h3 class="font-titulo">Similis<br />El Último Refugio</h3>
                <div class="card-subtitle font-ui">Saga Similis<br />IV</div>
            </div>
        </div>
    </div>
</section>

<script type="module" src={worksStack}></script>
