---
interface Props {
    percentage?: number;
    label?: string;
    labelColor?: string;
}

const { percentage, label = "Completado", labelColor } = Astro.props;

const hasBar = percentage !== undefined;
const clamped = hasBar ? Math.min(100, Math.max(0, percentage!)) : 0;
---

<div class="percentage-bar font-ui">
    {
        hasBar ? (
            <>
                <div class="percentage-meta">
                    <span
                        class="percentage-label"
                        style={labelColor ? `color: ${labelColor}` : undefined}
                    >
                        {label}
                    </span>
                    <span class="percentage-value">{clamped}%</span>
                </div>
                <div class="percentage-track">
                    <div class="percentage-fill" style={`width: ${clamped}%`} />
                </div>
            </>
        ) : (
            <div
                class="percentage-coming-soon"
                style={labelColor ? `color: ${labelColor}` : undefined}
            >
                {label}
            </div>
        )
    }
</div>

<style>
    .percentage-bar {
        align-self: stretch;
        margin-top: 1rem;
    }

    .percentage-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.4rem;
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .percentage-label {
        color: var(--texto-oscuro);
    }

    .percentage-value {
        color: var(--acento-oro);
        font-weight: 600;
    }

    .percentage-track {
        width: 100%;
        height: 4px;
        background-color: rgba(138, 106, 61, 0.15);
        border: 1px solid rgba(138, 106, 61, 0.3);
        border-radius: 2px;
        overflow: hidden;
    }

    .percentage-fill {
        height: 100%;
        background: linear-gradient(
            to right,
            var(--color-principal-1),
            var(--acento-oro)
        );
        border-radius: 2px;
        transition: width 0.3s ease;
    }

    .percentage-coming-soon {
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--texto-oscuro);
        text-align: center;
        padding: 0.3rem 0 0 0;
        border-top: 1px solid rgba(138, 106, 61, 0.25);
        font-style: italic;
    }
</style>
