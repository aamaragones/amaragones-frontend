---
import ThemeToggle from "./ThemeToggle.astro";
---

<header>
    <div class="container">
        <div class="logo font-titulo header-logo">✥</div>
        <nav aria-label="Main navigation">
            <ul class="font-ui header-list">
                <li><a href="/" id="nav-inicio">Inicio</a></li>
                <li><a href="/#works">Obras</a></li>
                <li>
                    <a href="/socials"
                        ><span class="hide-on-mobile">Mis</span> redes</a
                    >
                </li>
                <li><a href="/store">Tienda</a></li>
                <ThemeToggle class="mobile-theme-toggle" />
            </ul>
        </nav>
        <ThemeToggle />
    </div>
</header>

<script>
  document.getElementById("nav-inicio")?.addEventListener("click", (e) => {
    if (window.location.pathname === "/") {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });
</script>
