---
import SocialCard from "./SocialCard.astro";
import socialsData from "../../data/socials.json";
import tiktokIcon from "../../assets/socials/tiktok.png";
import youtubeIcon from "../../assets/socials/youtube.png";
import instagramIcon from "../../assets/socials/instagram.png";
import xIcon from "../../assets/socials/x.png";
import blueskyIcon from "../../assets/socials/bluesky.webp";

interface Social {
    platform: string;
    handle: string;
    url: string;
    iconSrc: string;
}

const iconMap: Record<string, { src: string }> = {
    TikTok: tiktokIcon,
    YouTube: youtubeIcon,
    Instagram: instagramIcon,
    X: xIcon,
    Bluesky: blueskyIcon,
};

const socials: Social[] = socialsData;
---

<section class="socials-container">
    {
        socials.map((social) => (
            <SocialCard
                platform={social.platform}
                handle={social.handle}
                url={social.url}
                iconSrc={iconMap[social.platform].src}
            />
        ))
    }
</section>

<style>
    .socials-container {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
    }

    @media (max-width: 768px) {
        .socials-container {
            gap: 2.2rem;
            max-width: 100%;
        }
    }
</style>
