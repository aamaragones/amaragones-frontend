---
import ShieldIcon from "./ShieldIcon.astro";

interface Props {
    platform: string; // Ej: "TikTok"
    handle: string; // Ej: "@autor_fantasia"
    url: string; // Ej: "https://tiktok.com/..."
    iconSrc: string; // Ruta al icono para el escudo
}

const { platform, handle, url, iconSrc } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="social-box">
    <div class="shield-wrapper">
        <ShieldIcon iconSrc={iconSrc} altText={`Icono de ${platform}`} />
    </div>

    <div class="box-content">
        <span class="platform-title">{platform}</span>
        <span class="platform-handle">{handle}</span>
    </div>
</a>

<style>
    /* Variables basadas exactamente en tu paleta de colores */
    :root {
        --color-bg-tinta: #0b0f14;
        --color-bg-noche: #0f1424;
        --color-oro-viejo: #c6a15b;
        --color-ambar-hechizo: #e3a857;
        --color-pergamino: #e8e1d1;
        --color-gris-ceniza: #b7b2a6;
    }

    .social-box {
        position: relative;
        display: flex;
        align-items: center;

        /* Degradado sutil entre tus dos fondos oscuros */
        background: linear-gradient(
            135deg,
            var(--color-bg-tinta),
            var(--color-bg-noche)
        );
        border: 1px solid var(--color-oro-viejo);
        border-left: 0; /* La parte izquierda está "abierta" para el escudo */

        /* El padding izquierdo es amplio (80px) para dejarle la "cama" al escudo */
        padding: 18px 24px 18px 80px;
        margin-left: 32px; /* Margen externo para que el escudo que sobresale no se corte con el layout */

        text-decoration: none;
        border-radius: 0px; /* Esquinas completamente rectas para mantener la estética medieval */
        transition:
            transform 0.3s cubic-bezier(0.25, 1, 0.5, 1),
            border-color 0.3s ease,
            box-shadow 0.3s ease;
    }

    /* --- Posicionamiento Clave del Escudo --- */
    .shield-wrapper {
        position: absolute;
        left: -32px; /* Saca exactamente la mitad del escudo (64px / 2) fuera de la caja */
        top: 50%;
        transform: translateY(
            -50%
        ); /* Lo centra verticalmente a la perfección */
        transition: transform 0.3s ease;
    }

    /* --- Efectos de Interacción (Feedback Mágico) --- */
    .social-box:hover {
        border-color: var(--color-ambar-hechizo);
        /* Un resplandor ámbar muy sutil que simula magia/encantamiento */
        box-shadow: 0 0 15px rgba(223, 168, 87, 0.15);
        transform: translateX(
            6px
        ); /* La caja se desplaza ligeramente a la derecha */
    }

    .social-box:hover .shield-wrapper {
        /* El escudo reacciona expandiéndose un poco al hacer hover en la caja */
        transform: translateY(-50%) scale(1.08);
    }

    /* --- Estilos de Texto --- */
    .box-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .platform-title {
        font-family: "Trajan Pro", serif; /* Tu fuente de títulos */
        color: var(--color-pergamino);
        font-size: 1.15rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .platform-handle {
        font-family: "Montserrat", sans-serif; /* Tu fuente de interfaz */
        color: var(--color-gris-ceniza);
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
</style>
