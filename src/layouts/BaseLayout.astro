---
const {
    title = "Alquimista de lo imposible | A. M. Aragonés",
    description = "Sitio oficial de A. M. Aragonés, autor de Similis. Fantasía oscura y leyendas olvidadas.",
    image = "/og-image.png",
    keywords = "A. M. Aragonés, Similis, fantasía oscura, autor, novela fantástica, Saga Similis",
} = Astro.props;
import "../styles/global.css";
const favNeg = "/favicon-light.png";
const favPos = "/favicon-dark.png";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="A. M. Aragonés" />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:locale" content="es_ES" />
        <meta property="og:site_name" content="A. M. Aragonés" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <link
            id="favicon"
            rel="icon"
            type="image/png"
            sizes="512x512"
            href={favNeg}
            data-light={favPos}
            data-dark={favNeg}
        />
        <script
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="75219c3e-fc98-4bbc-91db-9d316c107058"></script>
        <script>
            (function () {
                try {
                    var KEY = "theme-mode";
                    var saved = localStorage.getItem(KEY);
                    var prefersLight =
                        window.matchMedia &&
                        window.matchMedia("(prefers-color-scheme: light)")
                            .matches;
                    var isLight = saved === "light" || (!saved && prefersLight);
                    if (isLight)
                        document.documentElement.classList.add("light-mode");
                    var link = document.getElementById(
                        "favicon",
                    ) as HTMLLinkElement | null;
                    if (link) {
                        var light = link.dataset && link.dataset.light;
                        var dark = link.dataset && link.dataset.dark;
                        link.href = isLight
                            ? light || link.href
                            : dark || link.href;
                    }
                } catch (e) {
                    /* fall back silently */
                }
            })();
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap"
            rel="stylesheet"
        />

        <slot name="head" />

        <!-- Global styles are imported in the component frontmatter so Astro can bundle them -->
    </head>
    <body>
        <slot name="header" />
        <main>
            <slot />
        </main>
        <slot name="footer" />
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var KEY = "theme-mode";
                var btnHeader = document.getElementById("theme-toggle-header");
                var btnMobile = document.getElementById("theme-toggle-mobile");
                var buttons = [btnHeader, btnMobile].filter(
                    (b): b is HTMLElement => b !== null,
                );

                if (!buttons.length) return;

                function updateAria(isLight: boolean) {
                    buttons.forEach((btn) => {
                        btn.setAttribute("aria-pressed", String(!!isLight));
                        btn.setAttribute(
                            "aria-label",
                            isLight
                                ? "Cambiar a modo oscuro"
                                : "Cambiar a modo claro",
                        );
                    });
                }

                function updateFavicon(isLight: boolean) {
                    try {
                        var link = document.getElementById(
                            "favicon",
                        ) as HTMLLinkElement | null;
                        if (!link) return;
                        var LIGHT = link.dataset && link.dataset.light;
                        var DARK = link.dataset && link.dataset.dark;
                        link.href = isLight
                            ? LIGHT || link.href
                            : DARK || link.href;
                    } catch (e) {}
                }

                var initialIsLight =
                    document.documentElement.classList.contains("light-mode");
                updateAria(initialIsLight);
                updateFavicon(initialIsLight);

                buttons.forEach((btn) => {
                    btn.addEventListener("click", function () {
                        var isLight =
                            document.documentElement.classList.toggle(
                                "light-mode",
                            );
                        try {
                            localStorage.setItem(
                                KEY,
                                isLight ? "light" : "dark",
                            );
                        } catch (e) {}
                        updateAria(isLight);
                        updateFavicon(isLight);
                    });
                });
            });
        </script>
    </body>
</html>
