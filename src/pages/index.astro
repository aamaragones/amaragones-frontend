---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/home/Header.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/home/About.astro";
import Works from "../components/home/Works.astro";
import WorksCarousel from "../components/home/WorksCarousel.astro";
import Footer from "../components/home/Footer.astro";

const title = "Inicio | A. M. Aragonés";
const description = "Sitio oficial de A. M. Aragonés — autor de Similis.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <Hero />

  <About />

  <Works />

  <WorksCarousel />

  <Footer slot="footer" />
</BaseLayout>
