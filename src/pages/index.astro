---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/home/Header.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/home/About.astro";
import Works from "../components/home/Works.astro";
import Footer from "../components/home/Footer.astro";

const title = "A. M. Aragonés | Inicio";
const description = "Sitio oficial de A. M. Aragonés — autor de Similis.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <Hero />

  <About />

  <Works />

  <Footer slot="footer" />
</BaseLayout>
