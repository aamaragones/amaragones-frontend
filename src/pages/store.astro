                description:
                    "Set de 3 tazas de alquimia oficiales de la Saga Similis de A. M. Aragonés.",
                image: "https://www.amaragones.com/store",
                offers: {
                    "@type": "Offer",
                    availability: "https://schema.org/PreOrder",
                    priceCurrency: "EUR",
                    seller: { "@type": "Person", name: "A. M. Aragonés" },
                },
            },
