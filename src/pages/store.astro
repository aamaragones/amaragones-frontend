---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/home/Header.astro";
import Footer from "../components/home/Footer.astro";
import StoreHero from "../components/store/StoreHero.astro";
import StoreSection from "../components/store/Store.astro";
import StoreElement from "../components/store/StoreElement.astro";
import worksStack from "../scripts/works-stack.js?url";
import camisetaNegra from "../assets/merchandising/camiseta_negra.png";
import camisetaBlanca from "../assets/merchandising/camiseta_blanca.png";
import sudaderaNegra from "../assets/merchandising/sudadera_negra_bolsillo.png";
import sudaderaNegraSin from "../assets/merchandising/sudadera_negra.png";
import sudaderaBlanca from "../assets/merchandising/sudadera_blanca.png";
import separadores from "../assets/merchandising/marcapaginas.png";
import pocketNeg from "../assets/logo/pocket-.png";
import tazasAlquimia from "../assets/merchandising/tazas_alquimia.png";

const jsonLdBreadcrumb = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Inicio",
            item: "https://www.amaragones.com",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Tienda",
            item: "https://www.amaragones.com/store",
        },
    ],
});

const jsonLdVideo = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: "Tráiler oficial de Similis: Pluma y Espada",
