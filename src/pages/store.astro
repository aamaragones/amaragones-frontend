    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Merchandising oficial Saga Similis",
    description:
        "Merchandising exclusivo de la Saga Similis de A. M. Aragonés: sudaderas, camisetas, marcapáginas y tazas.",
    numberOfItems: 7,
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            item: {
                "@type": "Product",
                name: "Sudadera Negra Saga Similis — Edición Sin Bolsillo",
                brand: { "@type": "Brand", name: "A. M. Aragonés" },
                description:
                    "Sudadera negra oficial de la Saga Similis de A. M. Aragonés. Edición Sin Bolsillo.",
                image: "https://www.amaragones.com/store",
                offers: {
                    "@type": "Offer",
                    availability: "https://schema.org/PreOrder",
                    priceCurrency: "EUR",
                    seller: { "@type": "Person", name: "A. M. Aragonés" },
                },
            },
        },
        {
            "@type": "ListItem",
            position: 2,
            item: {
                "@type": "Product",
                name: "Sudadera Blanca Saga Similis — Edición Blanca",
                brand: { "@type": "Brand", name: "A. M. Aragonés" },
                description:
                    "Sudadera blanca oficial de la Saga Similis de A. M. Aragonés. Edición Blanca.",
                image: "https://www.amaragones.com/store",
                offers: {
                    "@type": "Offer",
                    availability: "https://schema.org/PreOrder",
                    priceCurrency: "EUR",
                    seller: { "@type": "Person", name: "A. M. Aragonés" },
                },
            },
        },
        {
            "@type": "ListItem",
            position: 3,
            item: {
                "@type": "Product",
                name: "Camiseta Negra Saga Similis — Edición Limitada",
                brand: { "@type": "Brand", name: "A. M. Aragonés" },
                description:
                    "Camiseta negra oficial de la Saga Similis de A. M. Aragonés. Edición Limitada.",
                image: "https://www.amaragones.com/store",
                offers: {
                    "@type": "Offer",
                    availability: "https://schema.org/PreOrder",
                    priceCurrency: "EUR",
                    seller: { "@type": "Person", name: "A. M. Aragonés" },
                },
            },
        },
        {
            "@type": "ListItem",
            position: 4,
            item: {
                "@type": "Product",
                name: "Camiseta Blanca Saga Similis — Edición Blanca",
                brand: { "@type": "Brand", name: "A. M. Aragonés" },
                description:
                    "Camiseta blanca oficial de la Saga Similis de A. M. Aragonés. Edición Blanca.",
                image: "https://www.amaragones.com/store",
                offers: {
                    "@type": "Offer",
                    availability: "https://schema.org/PreOrder",
                    priceCurrency: "EUR",
                    seller: { "@type": "Person", name: "A. M. Aragonés" },
                },
            },
        },
        {
            "@type": "ListItem",
            position: 5,
            item: {
                "@type": "Product",
                name: "Sudadera Negra con Bolsillo Saga Similis — Comodidad Premium",
                brand: { "@type": "Brand", name: "A. M. Aragonés" },
                description:
                    "Sudadera negra con bolsillo canguro oficial de la Saga Similis de A. M. Aragonés. Comodidad Premium.",
                image: "https://www.amaragones.com/store",
                offers: {
                    "@type": "Offer",
                    availability: "https://schema.org/PreOrder",
                    priceCurrency: "EUR",
                    seller: { "@type": "Person", name: "A. M. Aragonés" },
                },
            },
        },
        {
            "@type": "ListItem",
            position: 6,
            item: {
                "@type": "Product",
                name: "Marcapáginas Saga Similis — Set de 3",
                brand: { "@type": "Brand", name: "A. M. Aragonés" },
                description:
                    "Set de 3 marcapáginas oficiales de la Saga Similis de A. M. Aragonés.",
                image: "https://www.amaragones.com/store",
                offers: {
                    "@type": "Offer",
                    availability: "https://schema.org/PreOrder",
                    priceCurrency: "EUR",
                    seller: { "@type": "Person", name: "A. M. Aragonés" },
