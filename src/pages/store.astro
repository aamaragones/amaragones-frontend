---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/home/Header.astro";
import Footer from "../components/home/Footer.astro";
import StoreHero from "../components/store/StoreHero.astro";
import StoreSection from "../components/store/Store.astro";
import StoreElement from "../components/store/StoreElement.astro";
import worksStack from "../scripts/works-stack.js?url";
import camisetaNegra from "../assets/merchandising/camiseta_negra.png";
import sudaderaNegra from "../assets/merchandising/sudadera_negra_bolsillo.png";
import separadores from "../assets/merchandising/separadores.png";
---

<BaseLayout
    title="Tienda | A. M. Aragonés"
    description="Tienda de A. M. Aragonés"
>
    <Header slot="header" />

    <StoreHero
        title="Tienda"
        overtitle="A. M. Aragonés"
        description="Explora nuestro catálogo de libros y merchandising"
    />

    <StoreSection title="Libros" ariaLabel="Libros disponibles" noStack>
        <div class="libros-container">
            <div class="short-wrapper">
                <div id="yt-player"></div>
                <button
                    id="yt-unmute-btn"
                    aria-label="Activar sonido"
                    title="Activar sonido"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        width="18"
                        height="18"
                    >
                        <path
                            d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
                        ></path>
                    </svg>
                </button>
            </div>
        </div>
    </StoreSection>

    <StoreSection title="Merchandising" ariaLabel="Merchandising disponible">
        <StoreElement
            title="Camiseta Pluma y Espada"
            subtitle="Edición Limitada"
            backgroundGradient="linear-gradient(135deg, rgba(70, 50, 30, 0.0) 0%, rgba(40, 60, 80, 0.0) 100%)"
            image={camisetaNegra.src}
        />
        <StoreElement
            title="Sudadera Saga Similis"
            subtitle="Comodidad Premium"
            backgroundGradient="linear-gradient(135deg, rgba(50, 70, 50, 0.0) 0%, rgba(70, 50, 70, 0.0) 100%)"
            image={sudaderaNegra.src}
        />
        <StoreElement
            title="Taza Alquimista"
            subtitle="Cerámica Artesanal"
            backgroundGradient="linear-gradient(135deg, rgba(80, 60, 40, 0.0) 0%, rgba(40, 70, 60, 0.0) 100%)"
        />
        <StoreElement
            title="Marcapáginas"
            subtitle="Set de 3"
            backgroundGradient="linear-gradient(135deg, rgba(60, 50, 80, 0.0) 0%, rgba(50, 80, 60, 0.0) 100%)"
            image={separadores.src}
        />
    </StoreSection>

    <Footer slot="footer" />
</BaseLayout>

<script type="module" src={worksStack}></script>

<script is:inline>
    (function () {
        var tag = document.createElement("script");
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);
    })();

    var ytPlayer;
    var isMuted = true;

    window.onYouTubeIframeAPIReady = function () {
        ytPlayer = new YT.Player("yt-player", {
            videoId: "p0Pbh2myy2E",
            width: "100%",
            height: "100%",
            playerVars: {
                autoplay: 1,
                mute: 1,
                loop: 1,
                playlist: "p0Pbh2myy2E",
                controls: 0,
                modestbranding: 1,
                rel: 0,
                playsinline: 1,
            },
            events: {
                onReady: function (e) {
                    e.target.playVideo();
                },
            },
        });
    };

    document
        .getElementById("yt-unmute-btn")
        .addEventListener("click", function () {
            if (!ytPlayer) return;
            if (isMuted) {
                ytPlayer.unMute();
                ytPlayer.setVolume(80);
                isMuted = false;
                this.setAttribute("aria-label", "Silenciar");
                this.title = "Silenciar";
                this.innerHTML =
                    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>';
            } else {
                ytPlayer.mute();
                isMuted = true;
                this.setAttribute("aria-label", "Activar sonido");
                this.title = "Activar sonido";
                this.innerHTML =
                    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>';
            }
        });
</script>

<style>
    .libros-container {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .short-wrapper {
        position: relative;
        width: 100%;
        max-width: 340px;
        aspect-ratio: 9 / 16;
        overflow: hidden;
        border: 1px solid rgba(138, 106, 61, 0.4);
    }

    #yt-player {
        width: 100%;
        height: 100%;
        display: block;
    }

    #yt-player iframe {
        width: 100% !important;
        height: 100% !important;
        border: none;
        display: block;
    }

    #yt-unmute-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        cursor: pointer;
        transition: background 0.2s;
        z-index: 10;
    }

    #yt-unmute-btn:hover {
        background: rgba(0, 0, 0, 0.8);
    }

    #yt-unmute-btn.muted svg path {
        /* X over the sound icon when muted */
    }
</style>
