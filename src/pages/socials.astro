---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/home/Header.astro";
import Footer from "../components/home/Footer.astro";
import SocialsList from "../components/socials/Socials.astro";
import SocialHero from "../components/socials/SocialHero.astro";
import baseNeg from "../assets/logo/base-.png";

const jsonLdBreadcrumb = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Inicio",
            item: "https://www.amaragones.com",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Redes Sociales",
            item: "https://www.amaragones.com/socials",
        },
    ],
});

const jsonLdSocialPage = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: "Redes Sociales de A. M. Aragonés",
    description:
        "Perfiles oficiales de A. M. Aragonés en Instagram, TikTok, YouTube, X y Bluesky (@aamaragones).",
    url: "https://www.amaragones.com/socials",
    about: {
        "@type": "Person",
        name: "A. M. Aragonés",
        url: "https://www.amaragones.com",
        sameAs: [
            "https://instagram.com/aamaragones",
            "https://tiktok.com/@aamaragones",
            "https://youtube.com/@aamaragones",
            "https://x.com/aamaragones",
            "https://bsky.app/profile/aamaragones.bsky.social",
        ],
    },
});
---

<BaseLayout
    title="Redes Sociales | A. M. Aragonés"
    description="Sigue a A. M. Aragonés en Instagram y otras redes sociales. Mantente al día sobre la Saga Similis y novedades del autor."
    keywords="A. M. Aragonés redes sociales, Instagram aamaragones, Similis autor redes"
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={jsonLdBreadcrumb} />
        <script type="application/ld+json" set:html={jsonLdSocialPage} />
    </Fragment>
    <Header slot="header" />

    <div class="socials-page">
        <SocialHero overtitle="Únete a" title="Mis Redes Sociales" />

        <section class="socials-content">
            <div class="container">
                <div class="section-header">
                    <span>Sígueme</span>
                </div>
                <div class="socials-row">
                    <SocialsList />
                    <span
                        class="pocket-aside"
                        aria-hidden="true"
                        style={`-webkit-mask-image: url('${baseNeg.src}'); mask-image: url('${baseNeg.src}'); position: absolute`}
                    ></span>
                </div>
            </div>
        </section>
    </div>

    <Footer slot="footer" />
</BaseLayout>

<style>
    .socials-page {
        width: 100%;
    }

    .socials-row {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 4rem;
        width: 100%;
        position: relative;
        padding-bottom: 4rem;
    }

    .pocket-aside {
        display: block;
        flex-shrink: 0;
        width: 260px;
        height: 374px;
        pointer-events: none;
        -webkit-mask-size: contain;
        mask-size: contain;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: bottom center;
        mask-position: bottom center;
        -webkit-mask-mode: luminance;
        mask-mode: luminance;
        background-color: white;
        bottom: 0;
        right: 4rem;
    }

    :global(html.light-mode) .pocket-aside {
        background-color: black;
    }

    @media (max-width: 1150px) {
        .socials-row {
            padding-bottom: 275px;
        }

        .pocket-aside {
            right: unset;
        }
    }

    .socials-hero {
        text-align: center;
        padding: 8rem 2rem;
        background: radial-gradient(
            circle at center,
            rgba(44, 90, 122, 0.1) 0%,
            rgba(15, 26, 36, 0.6) 90%
        );
        border-bottom: 1px solid rgba(138, 106, 61, 0.2);
    }

    .socials-hero h1 {
        font-size: 3.5rem;
        margin-bottom: 1.5rem;
        letter-spacing: 0.05em;
        color: var(--hero-titulo);
    }

    .socials-hero .overtitle {
        color: var(--acento-oro);
        font-weight: 600;
        font-family: "Montserrat", sans-serif;
        font-size: 0.9rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .socials-content {
        padding: 4rem 0 0;
    }

    .socials-content .container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .section-header {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        color: var(--acento-oro);
        margin-bottom: 3rem;
        font-family: "Cinzel", serif;
        font-size: 1.2rem;
        letter-spacing: 0.05em;
    }

    .section-header::before,
    .section-header::after {
        content: "";
        height: 1px;
        width: 80px;
        background-color: var(--acento-bronce);
    }

    @media (max-width: 768px) {
        .socials-hero h1 {
            font-size: 2.5rem;
        }

        .socials-content {
            padding: 2rem 0 0;
        }

        .socials-hero {
            padding: 4rem 1rem;
        }

        .section-header::before,
        .section-header::after {
            width: 40px;
        }
    }
</style>
